# Local development settings. Copy to `.env` (git ignores it) and edit:
#
#   cp -n .env.example .env
#
# Two things read this file:
#   - docker compose, automatically, for the MYSQL_*, API_PORT and OCURATE_* values below.
#   - your shell, when you run the service from the venv: `set -a; . ./.env; set +a`
#     (quote any value that contains spaces or shell characters).
#
# Never use these values outside your own machine.

# --- MySQL container (compose.yaml) ---
# These take effect the first time the mysql-data volume is created.
# After changing them, run `docker compose down -v` to reset the volume.
MYSQL_USER=ocurate
MYSQL_PASSWORD=dev-password
# Percent-encoded form of MYSQL_PASSWORD (@ becomes %40, / becomes %2F).
# Compose needs it even when you only start the mysql service.
MYSQL_PASSWORD_URLENCODED=dev-password
# Host ports. Change them if 3306 or 8000 are already taken.
# MYSQL_PORT=3306
# API_PORT=8000

# --- Service (read by compose for the api container) ---
OCURATE_API_KEY=dev-api-key
# Generates a random token secret at startup. Local use only, and not with --reload.
OCURATE_DEV_MODE=1
# Origin of the frontend dev page. Empty refuses every browser origin on /ws.
OCURATE_ALLOWED_ORIGINS=http://localhost:5173

# --- Service run from the venv ---
# Compose builds its own database URL for the api container and ignores this one.
# Keep the user and password in step with the MYSQL_* values above and encode the password.
OCURATE_DATABASE_URL=mysql+pymysql://ocurate:dev-password@127.0.0.1:3306/ocurate?charset=utf8mb4

# Not used yet: the signed result callback is not built.
# OCURATE_CALLBACK_URL=
# OCURATE_CALLBACK_SECRET=
